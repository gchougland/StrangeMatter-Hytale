npcRoles.SM_Anomaly_Scientist.name = Anomaly Scientist
items.SM_Lab_Cyan_Glass.name = Laboratory Cyan Glass
items.SM_Lab_Cyan_Glass.description=Cyan glazing recovered from an anomaly scientist laboratory. A thin translucent pane for specimen rooms and observation windows.
items.SM_Lab_Lamp.name = Laboratory Lamp
items.SM_Lab_Lamp.description=A luminous cyan ceiling panel from an anomaly scientist laboratory. Fits a full building cell for continuous laboratory lighting.
ui.itemcategory.SM_StrangeMatter_All=All Strange Matter
benchCategories.sm.shards=Shards & Lighting
items.SM_Anomalous_Dirt.name=Anomalous Dirt
items.SM_Anomalous_Dirt.description=Anomaly-saturated subsoil. The spectral veins remain after excavation; use it beneath anomalous grass or in laboratory terrain displays.
benchCategories.sm.furniture=Furniture
benchCategories.sm.building=Building
items.SM_Resonite_Chair.name=Resonite Chair
items.SM_Resonite_Chair.description=Take a seat between experiments. A padded chair with a sturdy resonite frame.
interactionHints.SM_Resonite_Chair=Press [{key}] to sit
items.SM_Resonite_Stool.name=Resonite Stool
items.SM_Resonite_Stool.description=A compact padded seat for your laboratory. Place it beside a work table.
interactionHints.SM_Resonite_Stool=Press [{key}] to sit
items.SM_Resonite_Sofa.name=Resonite Sofa
items.SM_Resonite_Sofa.description=Sit with a fellow scientist. Two padded seats share a resonite frame.
interactionHints.SM_Resonite_Sofa=Press [{key}] to sit
items.SM_Resonite_Table.name=Resonite Table
items.SM_Resonite_Table.description=A large work table with a soft surface and reinforced legs. Occupies a square of four blocks.
items.SM_Resonite_Desk.name=Resonite Desk
items.SM_Resonite_Desk.description=Organize your next experiment at a desk with a monitor, notes and sample flask. Decorative furniture.
items.SM_Resonite_Bed.name=Resonite Bed
items.SM_Resonite_Bed.description=Rest after a long experiment and set your respawn point using the normal bed controls.
interactionHints.SM_Resonite_Bed=Press [{key}] to sleep
items.SM_Resonite_Chest.name=Resonite Chest
items.SM_Resonite_Chest.description=Store 18 stacks of supplies. Place two matching chests side by side to combine them into one large chest.
interactionHints.SM_Resonite_Chest=Press [{key}] to open the chest
items.SM_Resonite_Wardrobe.name=Resonite Wardrobe
items.SM_Resonite_Wardrobe.description=Store 36 stacks of clothing and equipment behind a pair of sturdy cabinet doors.
interactionHints.SM_Resonite_Wardrobe=Press [{key}] to open the wardrobe
items.SM_Resonite_Bookshelf.name=Resonite Bookshelf
items.SM_Resonite_Bookshelf.description=Keep research books and sealed samples on display. Decorative furniture.
items.SM_Resonite_Wall_Shelf.name=Resonite Wall Shelf
items.SM_Resonite_Wall_Shelf.description=Mount books and a glowing sample flask on your laboratory wall. Decorative furniture.
items.SM_Resonite_Cabinet.name=Resonite Cabinet
items.SM_Resonite_Cabinet.description=Store 18 stacks of supplies in a compact cabinet with opening doors.
interactionHints.SM_Resonite_Cabinet=Press [{key}] to open the cabinet
items.SM_Resonite_Wall_Monitor.name=Resonite Wall Monitor
items.SM_Resonite_Wall_Monitor.description=A glowing display of unusual readings for your laboratory wall. Decorative furniture.
items.SM_Resonite_Ceiling_Vent.name=Resonite Ceiling Vent
items.SM_Resonite_Ceiling_Vent.description=Finish your laboratory ceiling with metal louvers and small cyan status lights. Decorative furniture.
items.SM_Resonite_Ladder.name=Resonite Ladder
items.SM_Resonite_Ladder.description=Climb between laboratory floors. Stack sections against a wall to extend the ladder.
items.SM_Resonite_Window.name=Resonite Window
items.SM_Resonite_Window.description=Look through pale cyan glass held in a strong resonite frame.
items.SM_Resonite_Sign.name=Resonite Sign
items.SM_Resonite_Sign.description=Mark your laboratory with a glowing flask plaque. This decorative sign cannot be edited.
items.SM_Resonite_Roof.name=Resonite Roof
items.SM_Resonite_Roof.description=Navy metal roofing. Automatically joins into inner corners, outer corners and ridge caps.
items.SM_Resonite_Roof_Shallow.name=Shallow Resonite Roof
items.SM_Resonite_Roof_Shallow.description=A broad, gentle metal roof slope. Place matching roofs beside it to form corners.
items.SM_Resonite_Roof_Steep.name=Steep Resonite Roof
items.SM_Resonite_Roof_Steep.description=A tall metal roof slope for sharp laboratory gables. Joins into inner and outer corners.
items.SM_Resonite_Roof_Flat.name=Flat Resonite Roof
items.SM_Resonite_Roof_Flat.description=A low metal roof panel for flat laboratory roofs, ledges and transitions.
items.SM_Resonite_Chest_Large.name=Large Resonite Chest
items.SM_Resonite_Chest_Large.description=Store 36 stacks of supplies in a joined chest. Breaking it returns two regular chests and its contents.
interactionHints.SM_Resonite_Chest_Large=Press [{key}] to open the large chest
items.SM_Anomaly_Nullifier.name=Anomaly Nullifier
items.SM_Anomaly_Nullifier.description=Suppresses anomaly effects within 12 blocks. Use to turn it on or off. Needs no fuel or resonant power.
interactionHints.SM_Anomaly_Nullifier=Press [{key}] to turn the anomaly nullifier on or off
items.SM_Resonant_Separator.name=Resonant Separator
items.SM_Resonant_Separator.description=Separates supported ore into twice the normal metal yield. Requires resonant power.
items.SM_Flux_Furnace.name=Flux Furnace
items.SM_Flux_Furnace.description=Smelts ordinary furnace recipes using resonant power instead of fuel.
items.SM_Pattern_Assembler.name=Pattern Assembler
items.SM_Pattern_Assembler.description=Repeats a known Workbench recipe using stored ingredients and resonant power.
items.SM_Gravitic_Tube.name=Gravitic Tube
items.SM_Gravitic_Tube.description=Moves items between configured containers through a suspended gravity field.
