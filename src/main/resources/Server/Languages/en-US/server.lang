items.SM_Lab_Cyan_Glass.name = Laboratory Cyan Glass
items.SM_Lab_Cyan_Glass.description=Cyan glazing recovered from an anomaly scientist laboratory. A thin translucent pane for specimen rooms and observation windows.
items.SM_Lab_Lamp.name = Laboratory Lamp
items.SM_Lab_Lamp.description=A luminous cyan ceiling panel from an anomaly scientist laboratory. Fits a full building cell for continuous laboratory lighting.
