resourceType.SM_Anomaly_Shards.name=Any Anomaly Shard
items.SM_Anomalous_Grass.name=Anomalous Grass
items.SM_Anomalous_Grass.description=Grass touched by unstable matter. Slowly spreads to nearby grass; a solid opaque covering turns it back to dirt.
items.SM_Anomaly_Resonator.name=Anomaly Resonator
items.SM_Anomaly_Resonator.description=Locate the nearest surveyed anomaly. Secondary cycles the six field frequencies or searches for any type.
items.SM_Chrono_Blister.name=Chrono Blister
items.SM_Chrono_Blister.description=Launch a temporal blister. Its impact leaves a ragged field that slows creatures and fades after 10 to 30 seconds.
items.SM_Chrono_Shard.name=Chrono Shard
items.SM_Chrono_Shard.description=Crystallized time from a temporal bloom. Condense it from the field or mine its ore; used in research-driven crafting and the Reality Forge.
items.SM_Chrono_Shard_Crystal.name=Chrono Shard Crystal
items.SM_Chrono_Shard_Crystal.description=A pointed bloom of four chrono shards. Emits a soft golden glow and attaches to any of six block faces.
items.SM_Chrono_Shard_Lamp.name=Chrono Shard Lamp
items.SM_Chrono_Shard_Lamp.description=A two-block standing lamp with a suspended chrono crystal. Casts bright golden light without fuel or resonant power.
items.SM_Chrono_Shard_Lantern.name=Chrono Shard Lantern
items.SM_Chrono_Shard_Lantern.description=A compact cage lantern sheltering a chrono crystal. Casts bright golden light without fuel or resonant power.
items.SM_Chrono_Shard_Ore.name=Chrono Shard Ore
items.SM_Chrono_Shard_Ore.description=Chrono shards trapped in stone. Mine with an iron-quality pickaxe or better to recover material attuned to time.
items.SM_Containment_Capsule.name=Containment Capsule
items.SM_Containment_Capsule.description=An empty anomaly vessel. Carry it while using the Echo Vacuum to seal a field inside.
items.SM_Containment_Capsule_Echoing_Shadow.name=Containment Capsule Echoing Shadow
items.SM_Containment_Capsule_Echoing_Shadow.description=A sealed echoing shadow, retaining its original identity. Throw the capsule to deploy the field on impact; transported fields grant no new scans.
items.SM_Containment_Capsule_Energetic.name=Containment Capsule Energetic
items.SM_Containment_Capsule_Energetic.description=A sealed energetic rift, retaining its original identity. Throw the capsule to deploy the field on impact; transported fields grant no new scans.
items.SM_Containment_Capsule_Gravity.name=Containment Capsule Gravity
items.SM_Containment_Capsule_Gravity.description=A sealed gravity anomaly, retaining its original identity. Throw the capsule to deploy the field on impact; transported fields grant no new scans.
items.SM_Containment_Capsule_Temporal_Bloom.name=Containment Capsule Temporal Bloom
items.SM_Containment_Capsule_Temporal_Bloom.description=A sealed temporal bloom, retaining its original identity. Throw the capsule to deploy the field on impact; transported fields grant no new scans.
items.SM_Containment_Capsule_Thoughtwell.name=Containment Capsule Thoughtwell
items.SM_Containment_Capsule_Thoughtwell.description=A sealed thoughtwell, retaining its original identity. Throw the capsule to deploy the field on impact; transported fields grant no new scans.
items.SM_Containment_Capsule_Warp_Gate.name=Containment Capsule Warp Gate
items.SM_Containment_Capsule_Warp_Gate.description=A sealed warp gate, retaining its original identity. Throw the capsule to deploy the field on impact; transported fields grant no new scans.
items.SM_Echo_Vacuum.name=Echo Vacuum
items.SM_Echo_Vacuum.description=Hold primary on an anomaly for two seconds to capture it. Requires an empty capsule and room for the filled vessel.
items.SM_Echoform_Imprinter.name=Echoform Imprinter
items.SM_Echoform_Imprinter.description=Hold primary on a creature or player for one second to copy their appearance. Secondary or Use restores your own form.
items.SM_Energetic_Shard.name=Energetic Shard
items.SM_Energetic_Shard.description=Crystallized energy from a energetic rift. Condense it from the field or mine its ore; used in research-driven crafting and the Reality Forge.
items.SM_Energetic_Shard_Crystal.name=Energetic Shard Crystal
items.SM_Energetic_Shard_Crystal.description=A pointed bloom of four energetic shards. Emits a soft electric cyan glow and attaches to any of six block faces.
items.SM_Energetic_Shard_Lamp.name=Energetic Shard Lamp
items.SM_Energetic_Shard_Lamp.description=A two-block standing lamp with a suspended energetic crystal. Casts bright electric cyan light without fuel or resonant power.
items.SM_Energetic_Shard_Lantern.name=Energetic Shard Lantern
items.SM_Energetic_Shard_Lantern.description=A compact cage lantern sheltering a energetic crystal. Casts bright electric cyan light without fuel or resonant power.
items.SM_Energetic_Shard_Ore.name=Energetic Shard Ore
items.SM_Energetic_Shard_Ore.description=Energetic shards trapped in stone. Mine with an iron-quality pickaxe or better to recover material attuned to energy.
items.SM_Fancy_Resonite_Tile.name=Fancy Resonite Tile
items.SM_Fancy_Resonite_Tile.description=An ornamental resonite panel with raised trim. Matches ordinary tiles for patterned laboratory floors and walls.
items.SM_Field_Scanner.name=Field Scanner
items.SM_Field_Scanner.description=Hold primary on a natural anomaly for two seconds to earn observations. Each field identity rewards your journal once.
items.SM_Gravitic_Shard.name=Gravitic Shard
items.SM_Gravitic_Shard.description=Crystallized gravity from a gravity anomaly. Condense it from the field or mine its ore; used in research-driven crafting and the Reality Forge.
items.SM_Gravitic_Shard_Crystal.name=Gravitic Shard Crystal
items.SM_Gravitic_Shard_Crystal.description=A pointed bloom of four gravitic shards. Emits a soft violet glow and attaches to any of six block faces.
items.SM_Gravitic_Shard_Lamp.name=Gravitic Shard Lamp
items.SM_Gravitic_Shard_Lamp.description=A two-block standing lamp with a suspended gravitic crystal. Casts bright violet light without fuel or resonant power.
items.SM_Gravitic_Shard_Lantern.name=Gravitic Shard Lantern
items.SM_Gravitic_Shard_Lantern.description=A compact cage lantern sheltering a gravitic crystal. Casts bright violet light without fuel or resonant power.
items.SM_Gravitic_Shard_Ore.name=Gravitic Shard Ore
items.SM_Gravitic_Shard_Ore.description=Gravitic shards trapped in stone. Mine with an iron-quality pickaxe or better to recover material attuned to gravity.
items.SM_Graviton_Hammer.name=Graviton Hammer
items.SM_Graviton_Hammer.description=Primary swings with thorium mining strength across a 3 by 3 face; crouch for one block. Hold secondary for 1, 2 or 3 seconds to tunnel 3, 6 or 9 blocks deep.
items.SM_Hoverboard.name=Hoverboard
items.SM_Hoverboard.description=Deploy near solid ground. Move to steer, sprint to boost and jump to hop; dismount to fold the board back into your inventory.
items.SM_Insight_Shard.name=Insight Shard
items.SM_Insight_Shard.description=Crystallized cognition from a thoughtwell. Condense it from the field or mine its ore; used in research-driven crafting and the Reality Forge.
items.SM_Insight_Shard_Crystal.name=Insight Shard Crystal
items.SM_Insight_Shard_Crystal.description=A pointed bloom of four insight shards. Emits a soft luminous cyan glow and attaches to any of six block faces.
items.SM_Insight_Shard_Lamp.name=Insight Shard Lamp
items.SM_Insight_Shard_Lamp.description=A two-block standing lamp with a suspended insight crystal. Casts bright luminous cyan light without fuel or resonant power.
items.SM_Insight_Shard_Lantern.name=Insight Shard Lantern
items.SM_Insight_Shard_Lantern.description=A compact cage lantern sheltering a insight crystal. Casts bright luminous cyan light without fuel or resonant power.
items.SM_Insight_Shard_Ore.name=Insight Shard Ore
items.SM_Insight_Shard_Ore.description=Insight shards trapped in stone. Mine with an iron-quality pickaxe or better to recover material attuned to cognition.
items.SM_Levitation_Pad.name=Levitation Pad
items.SM_Levitation_Pad.description=A glowing lift for your laboratory. Use to switch between rising and falling. Gently keeps you near the center as you travel up to 16 blocks. Move to the side to step out.
items.SM_Paradoxical_Energy_Cell.name=Paradoxical Energy Cell
items.SM_Paradoxical_Energy_Cell.description=A creative-only contradiction in a reinforced cage. Supplies up to 1000 RE per tick by default without consuming fuel.
items.SM_Raw_Resonite.name=Raw Resonite
items.SM_Raw_Resonite.description=Unrefined resonite locked in dark host rock. Smelt it into ingots for laboratory instruments and building materials.
items.SM_Reality_Forge.name=Reality Forge
items.SM_Reality_Forge.description=Assemble researched anomalous equipment from materials and the required shard types. Select a recipe and collect its finished output.
items.SM_Research_Machine.name=Research Machine
items.SM_Research_Machine.description=Load prepared research notes and solve their linked experiments. A stable result unlocks the corresponding discovery.
items.SM_Research_Notes.name=Research Notes
items.SM_Research_Notes.description=A written experiment proposal. Prepare its research topic with the Research Tablet, then test it in the Research Machine.
items.SM_Research_Tablet.name=Research Tablet
items.SM_Research_Tablet.description=Open your field journal to review discoveries, spend observations and prepare research notes for new experiments.
items.SM_Resonance_Condenser.name=Resonance Condenser
items.SM_Resonance_Condenser.description=Draw matching shards from a nearby anomaly. By default, consumes 2 RE per tick and produces one shard every 75 seconds within 10 blocks.
items.SM_Resonant_Burner.name=Resonant Burner
items.SM_Resonant_Burner.description=Burn ordinary furnace fuels to generate resonant energy. Produces 20 RE per tick by default; connect machines with resonant conduits.
items.SM_Resonant_Circuit.name=Resonant Circuit
items.SM_Resonant_Circuit.description=A tuned resonite control circuit. Used to assemble instruments, machines and more advanced Reality Forge devices.
items.SM_Resonant_Coil.name=Resonant Coil
items.SM_Resonant_Coil.description=A copper winding around a resonite conductor. A component for transferring and shaping anomalous energy.
items.SM_Resonant_Conduit.name=Resonant Conduit
items.SM_Resonant_Conduit.description=Connect adjacent energy sources and machines on any of six faces. Longer paths reduce transfer throughput; short routes deliver power faster.
items.SM_Resonite_Block.name=Resonite Block
items.SM_Resonite_Block.description=Nine resonite ingots compressed into a metal block. Useful for compact storage, construction, or crafting back into ingots.
items.SM_Resonite_Door.name=Resonite Door
items.SM_Resonite_Door.description=A hinged resonite laboratory door. Use to swing the reinforced panel open or closed.
items.SM_Resonite_Ingot.name=Resonite Ingot
items.SM_Resonite_Ingot.description=Refined resonite, the foundation of Strange Matter equipment. Smelt raw resonite or unpack a resonite block to obtain it.
items.SM_Resonite_Nugget.name=Resonite Nugget
items.SM_Resonite_Nugget.description=A small portion of refined resonite. Nine nuggets combine into one ingot at the laboratory bench.
items.SM_Resonite_Ore.name=Resonite Ore
items.SM_Resonite_Ore.description=Resonite veins embedded in ordinary stone. Mine with an iron-quality pickaxe or better to recover raw resonite.
items.SM_Resonite_Pillar.name=Resonite Pillar
items.SM_Resonite_Pillar.description=A ribbed structural column for laboratory walls and supports. Place along any of the three axes.
items.SM_Resonite_Tile.name=Resonite Tile
items.SM_Resonite_Tile.description=A navy resonite floor or wall panel, edged for clean laboratory construction.
items.SM_Resonite_Tile_Slab.name=Resonite Tile Slab
items.SM_Resonite_Tile_Slab.description=A half-height resonite panel. Place as an upper or lower slab, or combine two into a full tile.
items.SM_Resonite_Tile_Stairs.name=Resonite Tile Stairs
items.SM_Resonite_Tile_Stairs.description=Navy metal steps for your laboratory. They form corners when placed beside matching stairs. Can also be placed upside down.
items.SM_Resonite_Trapdoor.name=Resonite Trapdoor
items.SM_Resonite_Trapdoor.description=A sturdy metal hatch for lift shafts and secret passages. Use the handle to swing it open.
items.SM_Rift_Stabilizer.name=Rift Stabilizer
items.SM_Rift_Stabilizer.description=Harvest an energetic rift through a containment arch. Defaults to 100 RE per tick within 16 blocks, with at most three stabilizers per rift.
items.SM_Shade_Shard.name=Shade Shard
items.SM_Shade_Shard.description=Crystallized shadow from a echoing shadow. Condense it from the field or mine its ore; used in research-driven crafting and the Reality Forge.
items.SM_Shade_Shard_Crystal.name=Shade Shard Crystal
items.SM_Shade_Shard_Crystal.description=A pointed bloom of four shade shards. Emits a soft spectral blue glow and attaches to any of six block faces.
items.SM_Shade_Shard_Lamp.name=Shade Shard Lamp
items.SM_Shade_Shard_Lamp.description=A two-block standing lamp with a suspended shade crystal. Casts bright spectral blue light without fuel or resonant power.
items.SM_Shade_Shard_Lantern.name=Shade Shard Lantern
items.SM_Shade_Shard_Lantern.description=A compact cage lantern sheltering a shade crystal. Casts bright spectral blue light without fuel or resonant power.
items.SM_Shade_Shard_Ore.name=Shade Shard Ore
items.SM_Shade_Shard_Ore.description=Shade shards trapped in stone. Mine with an iron-quality pickaxe or better to recover material attuned to shadow.
items.SM_Spatial_Shard.name=Spatial Shard
items.SM_Spatial_Shard.description=Crystallized space from a warp gate. Condense it from the field or mine its ore; used in research-driven crafting and the Reality Forge.
items.SM_Spatial_Shard_Crystal.name=Spatial Shard Crystal
items.SM_Spatial_Shard_Crystal.description=A pointed bloom of four spatial shards. Emits a soft rose glow and attaches to any of six block faces.
items.SM_Spatial_Shard_Lamp.name=Spatial Shard Lamp
items.SM_Spatial_Shard_Lamp.description=A two-block standing lamp with a suspended spatial crystal. Casts bright rose light without fuel or resonant power.
items.SM_Spatial_Shard_Lantern.name=Spatial Shard Lantern
items.SM_Spatial_Shard_Lantern.description=A compact cage lantern sheltering a spatial crystal. Casts bright rose light without fuel or resonant power.
items.SM_Spatial_Shard_Ore.name=Spatial Shard Ore
items.SM_Spatial_Shard_Ore.description=Spatial shards trapped in stone. Mine with an iron-quality pickaxe or better to recover material attuned to space.
items.SM_Stabilized_Core.name=Stabilized Core
items.SM_Stabilized_Core.description=A reinforced anomaly-energy core. A key component in advanced laboratory machinery and Reality Forge equipment.
items.SM_Stasis_Projector.name=Stasis Projector
items.SM_Stasis_Projector.description=A specimen display pad. Use to toggle its beam, which suspends one nearby creature and one dropped item above the emitter.
items.SM_Time_Dilation_Block.name=Time Dilation Block
items.SM_Time_Dilation_Block.description=A temporary golden temporal field. Creatures passing through are slowed; the field dissolves after 10 to 30 seconds.
items.SM_Tinfoil_Hat.name=Tinfoil Hat
items.SM_Tinfoil_Hat.description=Wear this carefully folded shield to keep Thoughtwell visions, rift shocks and strange gravity at bay. Suspicion, now with a brim.
items.SM_Warp_Gun.name=Warp Gun
items.SM_Warp_Gun.description=Fire cyan and purple bolts to create a pair of portals. Each portal opens above the surface its bolt hits. Travel through either linked portal. Use clears the pair.
items.SM_Laboratory_Bench.name=Laboratory Bench
items.SM_Laboratory_Bench.description=Craft your discoveries, furnish your laboratory and build a home for strange science. Choose a tab to find what you need.
