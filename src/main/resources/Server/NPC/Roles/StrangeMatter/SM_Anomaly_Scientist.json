{
  "Type": "Generic",
  "Parameters": {
    "Invulnerable": {
      "Value": false,
      "Description": "Whether this NPC is invulnerable."
    }
  },
  "StartState": "Idle",
  "DisplayNames": [
    "Anomaly Scientist"
  ],
  "DefaultNPCAttitude": "Ignore",
  "DefaultPlayerAttitude": "Neutral",
  "Appearance": "SM_Klops_Scientist",
  "MaxHealth": 100,
  "DisableDamageGroups": [
    "Self"
  ],
  "Invulnerable": {
    "Compute": "Invulnerable"
  },
  "KnockbackScale": 0.5,
  "MotionControllerList": [
    {
      "Type": "Walk",
      "MaxWalkSpeed": 7,
      "Gravity": 10,
      "RunThreshold": 0.3,
      "RunThresholdRange": 0.05,
      "MaxFallSpeed": 15,
      "MaxRotationSpeed": 360,
      "Acceleration": 10
    }
  ],
  "Instructions": [
    {
      "Instructions": [
        {
          "$Comment": "ScientistService owns this state while a nearby player has this scientist's trade page open.",
          "Sensor": {
            "Type": "State",
            "State": "Trading",
            "IgnoreMissingSetState": true
          },
          "Instructions": [
            {
              "Continue": true,
              "Sensor": { "Type": "Any", "Once": true },
              "Actions": [ { "Type": "PlayAnimation", "Slot": "Status" } ]
            },
            {
              "Continue": true,
              "Sensor": { "Type": "Player", "Range": 12 },
              "HeadMotion": { "Type": "Watch" }
            },
            {
              "Sensor": { "Type": "Any" },
              "BodyMotion": { "Type": "Nothing" }
            }
          ]
        },
        {
          "$Comment": "After being displaced, walk back close to the saved home before resuming the patrol.",
          "Sensor": { "Type": "State", "State": "Returning" },
          "Instructions": [
            {
              "Sensor": { "Type": "Leash", "Range": 0.75 },
              "BodyMotion": {
                "Type": "Seek",
                "SlowDownDistance": 1,
                "StopDistance": 0.5,
                "RelativeSpeed": 0.2,
                "UsePathfinder": true
              }
            },
            {
              "Sensor": { "Type": "Any" },
              "Actions": [ { "Type": "State", "State": "Idle" } ]
            }
          ]
        },
        {
          "Sensor": { "Type": "Leash", "Range": 4 },
          "Actions": [ { "Type": "State", "State": "Returning" } ]
        },
        {
          "$Comment": "Idle state - no player nearby",
          "Sensor": {
            "Type": "State",
            "State": "Idle"
          },
          "Instructions": [
            {
              "$Comment": "Greet player when they approach (Alerted animation)",
              "ActionsBlocking": true,
              "Sensor": {
                "Type": "Player",
                "Range": 8
              },
              "Actions": [
                {
                  "Type": "PlayAnimation",
                  "Slot": "Status",
                  "Animation": "Alerted"
                },
                {
                  "Type": "State",
                  "State": "Watching"
                }
              ]
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "BodyMotion": {
                "Type": "Sequence",
                "Looped": true,
                "Motions": [
                  {
                    "Type": "Timer",
                    "Time": [ 2, 4 ],
                    "Motion": {
                      "Type": "WanderInCircle",
                      "Radius": 4,
                      "RelativeSpeed": 0.2,
                      "MinWalkTime": 1,
                      "MaxWalkTime": 2,
                      "MaxHeadingChange": 60
                    }
                  },
                  { "Type": "Timer", "Time": [ 2, 5 ], "Motion": { "Type": "Nothing" } }
                ]
              }
            }
          ]
        },
        {
          "$Comment": "Watch nearby players while continuing a slow patrol until a trade page opens.",
          "Sensor": {
            "Type": "State",
            "State": "Watching"
          },
          "Instructions": [
            {
              "$Comment": "Watch nearby players with head",
              "Continue": true,
              "Sensor": {
                "Type": "Player",
                "Range": 12
              },
              "HeadMotion": {
                "Type": "Watch"
              }
            },
            {
              "$Comment": "Clear animation after delay",
              "Continue": true,
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "Timeout",
                  "Delay": [
                    2,
                    2
                  ],
                  "Action": {
                    "Type": "PlayAnimation",
                    "Slot": "Status"
                  }
                }
              ]
            },
            {
              "$Comment": "Return to Idle when player leaves (clear animation first)",
              "Sensor": {
                "Type": "Not",
                "Sensor": {
                  "Type": "Player",
                  "Range": 12
                }
              },
              "Actions": [
                {
                  "Type": "PlayAnimation",
                  "Slot": "Status"
                },
                {
                  "Type": "State",
                  "State": "Idle"
                }
              ]
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "BodyMotion": {
                "Type": "Sequence",
                "Looped": true,
                "Motions": [
                  {
                    "Type": "Timer",
                    "Time": [ 2, 4 ],
                    "Motion": {
                      "Type": "WanderInCircle",
                      "Radius": 4,
                      "RelativeSpeed": 0.2,
                      "MinWalkTime": 1,
                      "MaxWalkTime": 2,
                      "MaxHeadingChange": 60
                    }
                  },
                  { "Type": "Timer", "Time": [ 2, 5 ], "Motion": { "Type": "Nothing" } }
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "InteractionInstruction": {
    "Instructions": [
      {
        "Sensor": {
          "Type": "Not",
          "Sensor": {
            "Type": "CanInteract",
            "ViewSector": 180
          }
        },
        "Actions": [
          {
            "Type": "SetInteractable",
            "Interactable": false
          }
        ]
      },
      {
        "Continue": true,
        "Sensor": {
          "Type": "Any"
        },
        "Actions": [
          {
            "Type": "SetInteractable",
            "Interactable": true,
            "Hint": "server.interactionHints.trade"
          }
        ]
      }
    ]
  },
  "NameTranslationKey": "server.npcRoles.SM_Anomaly_Scientist.name",
  "$Comment": "ScientistService consumes native StateSupport interactions and opens tiered trade UI."
}
