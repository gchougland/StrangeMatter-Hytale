$C = "../Common.ui";
$R = "ResearchStyle.ui";

$C.@PageOverlay {
  LayoutMode: Middle;
  Group {
    LayoutMode: Center;
    Group #Tablet {
      Anchor: (Width: 1032, Height: 690);
      Background: #293658;
      Padding: (Full: 2);
      Group {
        Background: #0c1425;
        LayoutMode: Top;
        Padding: (Full: 24);
        Group {
          LayoutMode: Left;
          Anchor: (Height: 45);
          Group { FlexWeight: 1; LayoutMode: Top;
            Label { Text: "STRANGE MATTER / RESEARCH ARCHIVE"; Style: (FontSize: 23, TextColor: #68eef5, RenderBold: true); Anchor: (Height: 28); }
            Label #Scanned { Style: $R.@Caption; Anchor: (Height: 17); }
          }
          $R.@Control #Close { Text: "CLOSE"; Anchor: (Width: 85, Height: 32); }
        }
        Group { Anchor: (Height: 2, Top: 12, Bottom: 12); Background: #705691; }
        Label #Points { Style: (FontSize: 13, TextColor: #baa4e8); Anchor: (Height: 25); }
        Group {
          LayoutMode: Left;
          Anchor: (Height: 37, Bottom: 12);
          $R.@Control #General { Text: "FOUNDATIONS + ANOMALIES"; Anchor: (Width: 277, Height: 34, Right: 8); }
          $R.@Control #Forge { Text: "REALITY FORGE"; Anchor: (Width: 190, Height: 34); }
          $R.@Control #Journal { Text: "FIELD JOURNAL"; Anchor: (Width: 190, Height: 34, Left: 8); }
        }
        Group {
          LayoutMode: Left;
          FlexWeight: 1;
          Group { Anchor: (Width: 335, Right: 20); Background: #101b2e; Padding: (Full: 8); LayoutMode: TopScrolling; ScrollbarStyle: $C.@DefaultScrollbarStyle;
            Group #Nodes { LayoutMode: Top; }
          }
          Group {
            FlexWeight: 1; LayoutMode: Top; Padding: (Full: 14); Background: #141c31;
            Label #NodeTitle { Style: (FontSize: 27, RenderBold: true, TextColor: #dcd3fc, Wrap: true); Anchor: (Height: 70); }
            Group { Anchor: (Height: 2, Bottom: 20); Background: #3c526f; }
            Label #Description { Style: (FontSize: 17, TextColor: #c3cfe5, Wrap: true); Anchor: (Height: 145); }
            Label #Prerequisites { Style: $R.@Caption; Anchor: (Height: 40); }
            Label #Costs { Style: (FontSize: 14, TextColor: #79e2ee, Wrap: true); Anchor: (Height: 44); }
            $R.@Control #Purchase { Text: "CREATE RESEARCH NOTE"; Anchor: (Height: 42, Bottom: 16); }
            Label #Message { Style: (FontSize: 13, TextColor: #ab9cca, Wrap: true); FlexWeight: 1; }
          }
        }
      }
    }
  }
}
