$C = "../Common.ui";

$C.@PageOverlay {}
Group {
  Anchor: (Width: 790, Height: 720);
  Background: #101a2a;
  Padding: (Full: 26);
  LayoutMode: Top;
  Label #Title { Anchor: (Height: 38); Style: (FontSize: 25, TextColor: #62efff, RenderBold: true); }
  Label { Text: "STRANGE MATTER  /  LABORATORY CONTROL"; Anchor: (Height: 26); Style: (FontSize: 12, TextColor: #987ecb); }
  Group { Anchor: (Height: 2); Background: #426c83; }
  Label #State { Anchor: (Height: 32); Style: (FontSize: 16, TextColor: #ba9bef); }
  Label #Power { Anchor: (Height: 30); Style: (FontSize: 15, TextColor: #9cd9e5); }
  Label #Progress { Anchor: (Height: 30); Style: (FontSize: 14, TextColor: #d6deee); }
  Group #FuelCapacity { LayoutMode: Top; Anchor: (Height: 48);
    Label #FuelCapacityText { Anchor: (Height: 28); Style: (FontSize: 13, TextColor: #9cd9e5); }
    Group { Anchor: (Height: 6); Background: #25354c;
      Group #FuelFill { Anchor: (Left: 0, Top: 0, Width: 0, Height: 6); Background: #62efff; }
    }
  }
  Label #Output { Anchor: (Height: 30); Style: (FontSize: 14, TextColor: #d6deee); }
  Group { LayoutMode: Left; Anchor: (Height: 40);
    $C.@TextButton #Fuel { @Text = "LOAD ONE"; Anchor: (Width: 140, Height: 40); }
    Group { Anchor: (Width: 8); }
    $C.@TextButton #FuelMax { @Text = "LOAD MAX"; Anchor: (Width: 140, Height: 40); }
    Group { Anchor: (Width: 8); }
    $C.@TextButton #Collect { @Text = "COLLECT OUTPUT"; Anchor: (Width: 200, Height: 40); }
    Group { Anchor: (Width: 8); }
    $C.@TextButton #Toggle { @Text = "DISABLE"; Anchor: (Height: 40); FlexWeight: 1; }
  }
  Group #ForgePanel { LayoutMode: Top; Anchor: (Height: 300); Padding: (Top: 18);
    Label #Recipe { Anchor: (Height: 30); Style: (FontSize: 21, TextColor: #62efff, RenderBold: true); }
    Label #Research { Anchor: (Height: 25); Style: (FontSize: 12, TextColor: #bd98f3); }
    Label #Ingredients { Anchor: (Height: 112); Style: (FontSize: 14, TextColor: #d6deee, Wrap: true); }
    Label #Shards { Anchor: (Height: 47); Style: (FontSize: 13, TextColor: #b6d4e9, Wrap: true); }
    Group { LayoutMode: Left; Anchor: (Height: 40);
      $C.@TextButton #Previous { @Text = "PREVIOUS"; Anchor: (Width: 145, Height: 40); }
      Group { Anchor: (Width: 8); }
      $C.@TextButton #Next { @Text = "NEXT RECIPE"; Anchor: (Width: 170, Height: 40); }
      Group { Anchor: (Width: 8); }
      $C.@TextButton #Craft { @Text = "COALESCE"; Anchor: (Height: 40); FlexWeight: 1; }
    }
  }
  Group { FlexWeight: 1; }
  Label #Message { Anchor: (Height: 70); Style: (FontSize: 14, TextColor: #93a9c6, Wrap: true); }
  $C.@CancelTextButton #Close { @Text = "CLOSE INSTRUMENT"; Anchor: (Height: 40); }
}
