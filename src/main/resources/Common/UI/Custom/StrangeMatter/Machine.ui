$B = "SharedButtons.ui";
$C = "../Common.ui";

$C.@PageOverlay {}
Group {
  Anchor: (Width: 1040, Height: 800);
  Background: #101a2a;
  Padding: (Full: 26);
  LayoutMode: Top;
  Label #Title { Anchor: (Height: 38); Style: (FontSize: 25, TextColor: #62efff, RenderBold: true); }
  Label { Text: "STRANGE MATTER  /  LABORATORY CONTROL"; Anchor: (Height: 26); Style: (FontSize: 12, TextColor: #987ecb); }
  Group { Anchor: (Height: 2); Background: #426c83; }
  Label #State { Anchor: (Height: 32); Style: (FontSize: 16, TextColor: #ba9bef); }
  Group #PowerMeter { Anchor: (Height: 78); }
  Label #Progress { Anchor: (Height: 30); Style: (FontSize: 14, TextColor: #d6deee); }
  Group #FuelCapacity { LayoutMode: Top; Anchor: (Height: 48);
    Label #FuelCapacityText { Anchor: (Height: 28); Style: (FontSize: 13, TextColor: #9cd9e5); }
    Group { Anchor: (Width: 738, Height: 6); Background: #25354c;
      Group #FuelFill { Anchor: (Left: 0, Top: 0, Width: 0, Height: 6); Background: #62efff; }
    }
  }
  Group #InventoryHost { Anchor: (Height: 310); }
  Group { LayoutMode: Left; Anchor: (Height: 38);
    $B.@TextButton #Toggle { @Text = "PAUSE"; Anchor: (Width: 220, Height: 38); }
    Group { Anchor: (Width: 12); }
    $B.@TextButton #Recovery { @Text = "RECOVERED ITEMS"; Anchor: (Width: 220, Height: 38); Visible: false; }
  }
  Group { FlexWeight: 1; }
  Label #Message { Anchor: (Height: 70); Style: (FontSize: 14, TextColor: #93a9c6, Wrap: true); }
  $B.@CancelTextButton #Close { @Text = "CLOSE INSTRUMENT"; Anchor: (Height: 40); }
}
