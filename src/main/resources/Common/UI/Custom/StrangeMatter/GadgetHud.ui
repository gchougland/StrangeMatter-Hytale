Group #GadgetPanel {
  Anchor: (Right: 34, Bottom: 176, Width: 376, Height: 244);
  HitTestVisible: false;
  Background: #263955;
  Padding: (Full: 1);
  Group {
    Background: #101b2e;
    Group #GadgetAccent { Anchor: (Left: 0, Top: 0, Width: 3, Bottom: 0); Background: #67e8ef; }
    ItemIcon #GadgetIcon { Anchor: (Left: 14, Top: 10, Width: 46, Height: 46); ItemId: "SM_Research_Tablet"; }
    Label #GadgetTitle { Anchor: (Left: 70, Top: 15, Width: 286, Height: 36); Text: "STRANGE MATTER / INSTRUMENT"; Style: (FontSize: 12, TextColor: #6ee8ef, RenderBold: true, Wrap: true); }
    Group { Anchor: (Left: 16, Top: 63, Width: 340, Height: 1); Background: #29425c; }
    Label #GadgetStatus { Anchor: (Left: 16, Top: 73, Width: 340, Height: 58); Style: (FontSize: 16, TextColor: #c1a5ef, RenderBold: true, Wrap: true); }
    Label #GadgetDetail { Anchor: (Left: 16, Top: 137, Width: 340, Height: 54); Style: (FontSize: 12, TextColor: #adc0d5, Wrap: true); }
    Group #GadgetDiscipline { Anchor: (Left: 16, Top: 197, Width: 340, Height: 24); Visible: false;
      Group #GadgetDisciplineIcon { Anchor: (Left: 0, Top: 0, Width: 24, Height: 24); }
      Label #GadgetDisciplineName { Anchor: (Left: 32, Top: 2, Width: 308, Height: 20); Style: (FontSize: 12, TextColor: #c1a5ef, RenderBold: true); }
    }
    Group #GadgetProgress { Anchor: (Left: 16, Top: 228, Width: 340, Height: 5); Background: #293a55; Visible: false;
      Group #GadgetProgressFill { Anchor: (Left: 0, Top: 0, Width: 1, Height: 5); Background: #67e8ef; }
    }
    Group #GadgetEnergy { Anchor: (Left: 16, Top: 240, Width: 340, Height: 38); Visible: false;
      Label #GadgetEnergyText { Anchor: (Left: 0, Top: 0, Width: 340, Height: 22); Style: (FontSize: 12, TextColor: #b9e9ec, RenderBold: true); }
      Group { Anchor: (Left: 0, Top: 26, Width: 340, Height: 7); Background: #293a55;
        Group #GadgetEnergyFill { Anchor: (Left: 0, Top: 0, Width: 1, Height: 7); Background: #50e7ec; }
      }
    }
    Group #GadgetPack { Anchor: (Left: 16, Top: 289, Width: 340, Height: 26); Visible: false;
      Label #GadgetPackText { Anchor: (Full: 0); Style: (FontSize: 11, TextColor: #c1a5ef); }
    }
  }
}
