$C = "../Common.ui";
$R = "ResearchStyle.ui";
$G = "CognitionGlyphs.ui";

$C.@PageOverlay {
 LayoutMode: Middle;
 Group { LayoutMode: Center;
  Group { Anchor: (Width: 1036, Height: 850); Background: #2b3858; Padding: (Full: 2);
   Group { Background: #0b1323; Padding: (Full: 24);
    Label #ResearchName { Anchor: (Left: 0, Top: 0, Width: 865, Height: 30); Text: "RESEARCH MACHINE"; Style: (FontSize: 22, TextColor: #75e9f1, RenderBold: true); }
    $R.@Control #Close { Text: "CLOSE"; Anchor: (Right: 0, Top: 0, Width: 83, Height: 30); }
    Label #Instability { Anchor: (Left: 0, Top: 39, Width: 600, Height: 22); Style: (FontSize: 13, TextColor: #b899e4, RenderBold: true); }
    Group { Anchor: (Left: 0, Top: 65, Width: 960, Height: 9); Background: #26314a;
     Group #InstabilityFill { Anchor: (Left: 0, Top: 0, Width: 480, Height: 9); Background: #51dce3; }
    }
Group { Anchor: (Left: 0, Top: 92, Width: 310, Height: 234); Background: #263553; Padding: (Full: 1);
 Group { Background: #101b2f;
 Group #COGNITIONIcon { Anchor: (Left: 10, Top: 12, Width: 18, Height: 18); Background: (TexturePath: "Disciplines/cognition.png"); HitTestVisible: false; }
 Label { Anchor: (Left: 34, Top: 10, Width: 264, Height: 23); Text: "COGNITION / MNEMONIC MATRIX"; Style: (FontSize: 12, TextColor: #8a9dc5, Wrap: true, HorizontalAlignment: Center); }

 Label #COGNITIONState { Anchor: (Left: 180, Top: 31, Width: 116, Height: 18); Text: "OFFLINE"; Style: (FontSize: 10, TextColor: #697a98, Wrap: true, HorizontalAlignment: Center); }

 Group #COGNITIONControls { Anchor: (Left: 10, Top: 53, Width: 288, Height: 174); Visible: false;
$R.@Control #Rune0 { Text: ""; Anchor: (Left: 76, Top: 0, Width: 37, Height: 29); }
$G.@Fork #RuneMark0 { Anchor: (Left: 76, Top: 0, Width: 37, Height: 29); }
$G.@ForkLit #RuneGlow0 { Anchor: (Left: 76, Top: 0, Width: 37, Height: 29); Background: #31526a; Visible: false; HitTestVisible: false; }
$R.@Control #Rune1 { Text: ""; Anchor: (Left: 118, Top: 0, Width: 37, Height: 29); }
$G.@Eye #RuneMark1 { Anchor: (Left: 118, Top: 0, Width: 37, Height: 29); }
$G.@EyeLit #RuneGlow1 { Anchor: (Left: 118, Top: 0, Width: 37, Height: 29); Background: #31526a; Visible: false; HitTestVisible: false; }
$R.@Control #Rune2 { Text: ""; Anchor: (Left: 160, Top: 0, Width: 37, Height: 29); }
$G.@Spiral #RuneMark2 { Anchor: (Left: 160, Top: 0, Width: 37, Height: 29); }
$G.@SpiralLit #RuneGlow2 { Anchor: (Left: 160, Top: 0, Width: 37, Height: 29); Background: #31526a; Visible: false; HitTestVisible: false; }
$R.@Control #Rune3 { Text: ""; Anchor: (Left: 76, Top: 34, Width: 37, Height: 29); }
$G.@Crown #RuneMark3 { Anchor: (Left: 76, Top: 34, Width: 37, Height: 29); }
$G.@CrownLit #RuneGlow3 { Anchor: (Left: 76, Top: 34, Width: 37, Height: 29); Background: #31526a; Visible: false; HitTestVisible: false; }
$R.@Control #Rune4 { Text: ""; Anchor: (Left: 118, Top: 34, Width: 37, Height: 29); }
$G.@Hourglass #RuneMark4 { Anchor: (Left: 118, Top: 34, Width: 37, Height: 29); }
$G.@HourglassLit #RuneGlow4 { Anchor: (Left: 118, Top: 34, Width: 37, Height: 29); Background: #31526a; Visible: false; HitTestVisible: false; }
$R.@Control #Rune5 { Text: ""; Anchor: (Left: 160, Top: 34, Width: 37, Height: 29); }
$G.@Gate #RuneMark5 { Anchor: (Left: 160, Top: 34, Width: 37, Height: 29); }
$G.@GateLit #RuneGlow5 { Anchor: (Left: 160, Top: 34, Width: 37, Height: 29); Background: #31526a; Visible: false; HitTestVisible: false; }
$R.@Control #Rune6 { Text: ""; Anchor: (Left: 76, Top: 68, Width: 37, Height: 29); }
$G.@Star #RuneMark6 { Anchor: (Left: 76, Top: 68, Width: 37, Height: 29); }
$G.@StarLit #RuneGlow6 { Anchor: (Left: 76, Top: 68, Width: 37, Height: 29); Background: #31526a; Visible: false; HitTestVisible: false; }
$R.@Control #Rune7 { Text: ""; Anchor: (Left: 118, Top: 68, Width: 37, Height: 29); }
$G.@Comet #RuneMark7 { Anchor: (Left: 118, Top: 68, Width: 37, Height: 29); }
$G.@CometLit #RuneGlow7 { Anchor: (Left: 118, Top: 68, Width: 37, Height: 29); Background: #31526a; Visible: false; HitTestVisible: false; }
$R.@Control #Rune8 { Text: ""; Anchor: (Left: 160, Top: 68, Width: 37, Height: 29); }
$G.@Orbit #RuneMark8 { Anchor: (Left: 160, Top: 68, Width: 37, Height: 29); }
$G.@OrbitLit #RuneGlow8 { Anchor: (Left: 160, Top: 68, Width: 37, Height: 29); Background: #31526a; Visible: false; HitTestVisible: false; }
Label #CognitionReadout { Anchor: (Left: 0, Top: 111, Width: 288, Height: 23); Text: "Recall the sequence 0/3"; Style: (FontSize: 12, TextColor: #c0abd9, Wrap: true, HorizontalAlignment: Center); }
Label  { Anchor: (Left: 0, Top: 137, Width: 288, Height: 34); Text: "Watch the glowing symbols, then repeat their order. A new pattern emerges after 30 seconds."; Style: (FontSize: 11, TextColor: #8197b9, Wrap: true, HorizontalAlignment: Center); }
}
 Group #COGNITIONShutter { Anchor: (Left: 0, Top: 0, Right: 0, Bottom: 0); Background: #131e33;
Group #COGNITIONSlat0 { Anchor: (Left: 0, Top: 15, Width: 288, Height: 2); Background: #213049; HitTestVisible: false; }
Group #COGNITIONSlat1 { Anchor: (Left: 0, Top: 37, Width: 288, Height: 2); Background: #213049; HitTestVisible: false; }
Group #COGNITIONSlat2 { Anchor: (Left: 0, Top: 59, Width: 288, Height: 2); Background: #213049; HitTestVisible: false; }
Group #COGNITIONSlat3 { Anchor: (Left: 0, Top: 81, Width: 288, Height: 2); Background: #213049; HitTestVisible: false; }
Group #COGNITIONSlat4 { Anchor: (Left: 0, Top: 103, Width: 288, Height: 2); Background: #213049; HitTestVisible: false; }
Group #COGNITIONSlat5 { Anchor: (Left: 0, Top: 125, Width: 288, Height: 2); Background: #213049; HitTestVisible: false; }
Group #COGNITIONSlat6 { Anchor: (Left: 0, Top: 147, Width: 288, Height: 2); Background: #213049; HitTestVisible: false; }
Group #COGNITIONShutterIcon { Anchor: (Left: 142, Top: 65, Width: 24, Height: 24); Background: (TexturePath: "Disciplines/cognition.png"); HitTestVisible: false; }
Label { Anchor: (Left: 12, Top: 93, Width: 284, Height: 17); Text: "COGNITION"; Style: (FontSize: 11, TextColor: #8b9caf, HorizontalAlignment: Center); HitTestVisible: false; }
Label  { Anchor: (Left: 12, Top: 115, Width: 284, Height: 36); Text: "SEALED / DISCIPLINE NOT REQUIRED"; Style: (FontSize: 10, TextColor: #64738f, Wrap: true, HorizontalAlignment: Center); }
}
}
}
