$R.@Control #SpaceHorizontal { Text: "HORIZONTAL"; Padding: (Horizontal: 2); Anchor: (Left: 12, Top: 86, Width: 126, Height: 26); TooltipText: "Select this bend. Each press moves it two stops and the other bend one stop."; }
$R.@Control #SpaceVertical { Text: "VERTICAL"; Padding: (Horizontal: 2); Anchor: (Left: 150, Top: 86, Width: 126, Height: 26); TooltipText: "Select this bend. Each press moves it two stops and the other bend one stop."; }
Group #SpaceAxisSelection { Anchor: (Left: 12, Top: 113, Width: 126, Height: 2); Background: #78f3e3; HitTestVisible: false; }
$R.@Control #SpaceMinus { Text: "WARP IN"; Anchor: (Left: 12, Top: 119, Width: 126, Height: 28); TooltipText: "Decrease both bends. Bring both near zero within the shown margin. The lattice settles when close enough."; }
$R.@Control #SpacePlus { Text: "WARP OUT"; Anchor: (Left: 150, Top: 119, Width: 126, Height: 28); TooltipText: "Increase both bends. Bring both near zero within the shown margin. The lattice settles when close enough."; }
Label #SpaceReadout { Anchor: (Left: 0, Top: 150, Width: 288, Height: 24); Text: "Bring both bends near zero"; Style: (FontSize: 11, TextColor: #8197b9, Wrap: true, HorizontalAlignment: Center); }
