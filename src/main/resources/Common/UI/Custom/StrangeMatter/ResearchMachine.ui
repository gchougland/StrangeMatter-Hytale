Label #EnergyReadout { Anchor: (Left: 0, Top: 87, Width: 288, Height: 20); Text: "Amplitude / Period"; Style: (FontSize: 11, TextColor: #92c6d5, Wrap: true, HorizontalAlignment: Center); }
