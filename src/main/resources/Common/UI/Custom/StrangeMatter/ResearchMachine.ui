Group #COGNITIONSlat6 { Anchor: (Left: 0, Top: 147, Width: 288, Height: 2); Background: #213049; HitTestVisible: false; }
Label  { Anchor: (Left: 12, Top: 106, Width: 284, Height: 36); Text: "SEALED / DISCIPLINE NOT REQUIRED"; Style: (FontSize: 10, TextColor: #64738f, Wrap: true, HorizontalAlignment: Center); }
}
}
}
