$C = "../Common.ui";
$R = "ResearchStyle.ui";

$C.@PageOverlay {
 LayoutMode: Middle;
 Group { LayoutMode: Center;
  Group { Anchor: (Width: 1032, Height: 760); Background: #2b3858; Padding: (Full: 2);
   Group { Background: #0b1323; Padding: (Full: 24);
    Label #ResearchName { Anchor: (Left: 0, Top: 0, Width: 865, Height: 30); Text: "RESEARCH MACHINE"; Style: (FontSize: 22, TextColor: #75e9f1, RenderBold: true); }
    $R.@Control #Close { Text: "CLOSE"; Anchor: (Right: 0, Top: 0, Width: 83, Height: 30); }
    Label #Instability { Anchor: (Left: 0, Top: 39, Width: 600, Height: 22); Style: (FontSize: 13, TextColor: #b899e4, RenderBold: true); }
    Group { Anchor: (Left: 0, Top: 65, Width: 960, Height: 9); Background: #26314a;
     Group #InstabilityFill { Anchor: (Left: 0, Top: 0, Width: 480, Height: 9); Background: #51dce3; }
    }
Group { Anchor: (Left: 0, Top: 92, Width: 310, Height: 234); Background: #263553; Padding: (Full: 1);
 Group { Background: #101b2f;
 Label  { Anchor: (Left: 10, Top: 10, Width: 290, Height: 23); Text: "COGNITION / MNEMONIC MATRIX"; Style: (FontSize: 12, TextColor: #8a9dc5, Wrap: true, HorizontalAlignment: Center); }

 Label #COGNITIONState { Anchor: (Left: 180, Top: 31, Width: 116, Height: 18); Text: "OFFLINE"; Style: (FontSize: 10, TextColor: #697a98, Wrap: true, HorizontalAlignment: Center); }

 Group #COGNITIONControls { Anchor: (Left: 10, Top: 53, Width: 288, Height: 174); Visible: false;
$R.@Control #Rune0 { Text: "1"; Anchor: (Left: 76, Top: 0, Width: 37, Height: 29); }
Group #RuneGlow0 { Anchor: (Left: 76, Top: 0, Width: 37, Height: 3); Background: #e7c38a; Visible: false; HitTestVisible: false; }
$R.@Control #Rune1 { Text: "2"; Anchor: (Left: 118, Top: 0, Width: 37, Height: 29); }
Group #RuneGlow1 { Anchor: (Left: 118, Top: 0, Width: 37, Height: 3); Background: #e7c38a; Visible: false; HitTestVisible: false; }
$R.@Control #Rune2 { Text: "3"; Anchor: (Left: 160, Top: 0, Width: 37, Height: 29); }
Group #RuneGlow2 { Anchor: (Left: 160, Top: 0, Width: 37, Height: 3); Background: #e7c38a; Visible: false; HitTestVisible: false; }
$R.@Control #Rune3 { Text: "4"; Anchor: (Left: 76, Top: 34, Width: 37, Height: 29); }
Group #RuneGlow3 { Anchor: (Left: 76, Top: 34, Width: 37, Height: 3); Background: #e7c38a; Visible: false; HitTestVisible: false; }
$R.@Control #Rune4 { Text: "5"; Anchor: (Left: 118, Top: 34, Width: 37, Height: 29); }
Group #RuneGlow4 { Anchor: (Left: 118, Top: 34, Width: 37, Height: 3); Background: #e7c38a; Visible: false; HitTestVisible: false; }
$R.@Control #Rune5 { Text: "6"; Anchor: (Left: 160, Top: 34, Width: 37, Height: 29); }
Group #RuneGlow5 { Anchor: (Left: 160, Top: 34, Width: 37, Height: 3); Background: #e7c38a; Visible: false; HitTestVisible: false; }
$R.@Control #Rune6 { Text: "7"; Anchor: (Left: 76, Top: 68, Width: 37, Height: 29); }
Group #RuneGlow6 { Anchor: (Left: 76, Top: 68, Width: 37, Height: 3); Background: #e7c38a; Visible: false; HitTestVisible: false; }
$R.@Control #Rune7 { Text: "8"; Anchor: (Left: 118, Top: 68, Width: 37, Height: 29); }
Group #RuneGlow7 { Anchor: (Left: 118, Top: 68, Width: 37, Height: 3); Background: #e7c38a; Visible: false; HitTestVisible: false; }
$R.@Control #Rune8 { Text: "9"; Anchor: (Left: 160, Top: 68, Width: 37, Height: 29); }
Group #RuneGlow8 { Anchor: (Left: 160, Top: 68, Width: 37, Height: 3); Background: #e7c38a; Visible: false; HitTestVisible: false; }
Label #CognitionReadout { Anchor: (Left: 0, Top: 111, Width: 288, Height: 23); Text: "Recall the sequence 0/3"; Style: (FontSize: 12, TextColor: #c0abd9, Wrap: true, HorizontalAlignment: Center); }
Label  { Anchor: (Left: 0, Top: 137, Width: 288, Height: 34); Text: "Watch the lit keys, then repeat their order. A new pattern emerges after 30 seconds."; Style: (FontSize: 11, TextColor: #8197b9, Wrap: true, HorizontalAlignment: Center); }
}
 Group #COGNITIONShutter { Anchor: (Left: 0, Top: 0, Right: 0, Bottom: 0); Background: #131e33;
Group #COGNITIONSlat0 { Anchor: (Left: 0, Top: 15, Width: 288, Height: 2); Background: #213049; HitTestVisible: false; }
Group #COGNITIONSlat1 { Anchor: (Left: 0, Top: 37, Width: 288, Height: 2); Background: #213049; HitTestVisible: false; }
